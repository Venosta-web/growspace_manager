---
# First-party YAML is linted repository-wide. Agent skill manifests are managed
# by the skill installer and must retain the format emitted by that tool.
ignore: |
  .agents/skills/*/agents/openai.yaml

extends: default

rules:
  comments:
    level: error
    min-spaces-from-content: 2
  document-start:
    level: error
    present: true
  line-length:
    max: 120
  # YAML 1.1 treats `on` as a boolean. Keep GitHub Actions workflow keys quoted
  # so generic YAML tooling and GitHub agree on their meaning.
  truthy:
    allowed-values:
      - "true"
      - "false"
    check-keys: true
    level: error
